# Simulator-only legacy challenge secret. Local Compose still passes it to the backend;
# normal auth mode does not use the hardware simulator endpoints.
RUNEVAULT_DEVICE_SECRET=local-demo-only-change-before-deploy
GEMINI_API_KEY=
# Switch when Google reports the default model as overloaded (HTTP 503), e.g. gemini-flash-lite-latest.
RUNEVAULT_GEMINI_MODEL=gemini-3.1-flash-lite
RUNEVAULT_MIN_TRANSLATION_CONFIDENCE=0.8
RUNEVAULT_MAX_RISK_SCORE=30
# Set to the UTF-8 key provisioned on the Pico; no built-in default.
RUNEVAULT_PICO_KEY=
RUNEVAULT_PICO_DEVICE_ID=slab-01
POSTGRES_PASSWORD=local-postgres-only-change-before-deploy
NESSIE_API_KEY=
NESSIE_SOURCE_ACCOUNT_ID=
# Normal auth mode requires true and valid Nessie configuration. Explicit dev,simulator mode requires false.
NESSIE_ENABLED=true
AUTH0_ISSUER_URI=https://YOUR-TENANT.auth0.com/
AUTH0_AUDIENCE=https://api.runevault
RUNEVAULT_BRIDGE_TOKEN=
RUNEVAULT_WS_ALLOWED_ORIGINS=http://localhost:4200
RUNEVAULT_WS_TICKET_SECONDS=30
RUNEVAULT_WS_MAX_TICKETS=10000
RUNEVAULT_WS_MAX_CONNECTIONS_PER_USER=3
RUNEVAULT_WS_TICKET_ISSUANCE_PER_WINDOW=30
# Per-backend-instance request quotas (window in seconds).
RUNEVAULT_RATE_WINDOW_SECONDS=60
RUNEVAULT_RATE_MAX_ENTRIES=10000
RUNEVAULT_DASHBOARD_READS_PER_WINDOW=300
RUNEVAULT_TRANSACTION_CREATION_PER_WINDOW=60
RUNEVAULT_BRIDGE_AUTHORIZATIONS_PER_WINDOW=120
RUNEVAULT_BRIDGE_OTHER_PER_WINDOW=120
RUNEVAULT_ADMIN_OPERATIONS_PER_WINDOW=60
RUNEVAULT_DECISION_EXPLANATIONS_PER_WINDOW=10
RUNEVAULT_UNAUTHENTICATED_PER_WINDOW=60
# Demo transaction policy: cents, comma-separated account IDs, wrong-glyph attempts.
RUNEVAULT_MAX_AMOUNT_MINOR=100000000
RUNEVAULT_ALLOWED_DESTINATIONS=acct-999,harbor
RUNEVAULT_MAX_INCORRECT_GLYPH_ATTEMPTS=5
