# Copy to .env.cloud on the server; replace every REPLACE_* value.
RUNEVAULT_DOMAIN=REPLACE_WITH_PUBLIC_HOSTNAME
AUTH0_ISSUER_URI=https://REPLACE_WITH_AUTH0_TENANT.auth0.com/
AUTH0_AUDIENCE=https://api.runevault
TIGER_JDBC_URL=jdbc:postgresql://REPLACE_WITH_TIGER_HOST:5432/REPLACE_WITH_DATABASE?sslmode=verify-full&sslrootcert=/run/tiger-certs/tiger-ca.pem
TIGER_USERNAME=REPLACE_WITH_TIGER_USERNAME
TIGER_PASSWORD=REPLACE_WITH_TIGER_PASSWORD
RUNEVAULT_BRIDGE_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_BRIDGE_TOKEN
RUNEVAULT_WS_ALLOWED_ORIGINS=https://REPLACE_WITH_PUBLIC_HOSTNAME
RUNEVAULT_WS_TICKET_SECONDS=30
RUNEVAULT_WS_MAX_TICKETS=10000
RUNEVAULT_WS_MAX_CONNECTIONS_PER_USER=3
RUNEVAULT_WS_TICKET_ISSUANCE_PER_WINDOW=30
RUNEVAULT_DEVICE_SECRET=REPLACE_WITH_PRIVATE_RANDOM_DEVICE_SECRET
RUNEVAULT_PICO_DEVICE_ID=REPLACE_WITH_REGISTERED_PICO_ID
RUNEVAULT_PICO_KEY=REPLACE_WITH_EXISTING_PICO_SIGNING_KEY
RUNEVAULT_MAX_AMOUNT_MINOR=100000000
RUNEVAULT_ALLOWED_DESTINATIONS=REPLACE_WITH_NESSIE_DESTINATION_ACCOUNT_UUIDS
RUNEVAULT_MAX_INCORRECT_GLYPH_ATTEMPTS=5
RUNEVAULT_MIN_TRANSLATION_CONFIDENCE=0.8
RUNEVAULT_MAX_RISK_SCORE=30
# Approving a transfer of this many cents or more needs step-up MFA (100000 = $1,000).
RUNEVAULT_STEP_UP_AMOUNT_MINOR=100000
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
NESSIE_ENABLED=true
NESSIE_API_KEY=REPLACE_WITH_NESSIE_SANDBOX_KEY
NESSIE_SOURCE_ACCOUNT_ID=REPLACE_WITH_NESSIE_SOURCE_ACCOUNT_UUID
RUNEVAULT_RATE_WINDOW_SECONDS=60
RUNEVAULT_RATE_MAX_ENTRIES=10000
RUNEVAULT_DASHBOARD_READS_PER_WINDOW=300
RUNEVAULT_TRANSACTION_CREATION_PER_WINDOW=60
RUNEVAULT_BRIDGE_AUTHORIZATIONS_PER_WINDOW=120
RUNEVAULT_BRIDGE_OTHER_PER_WINDOW=120
RUNEVAULT_ADMIN_OPERATIONS_PER_WINDOW=60
RUNEVAULT_UNAUTHENTICATED_PER_WINDOW=60
